# GOE Platform — environment configuration template
#
# Copy this file to `.env` and fill in each value below.
# A setup agent can read this file top-to-bottom and prompt you for each item.
# NEVER commit your real `.env` — only this template is tracked in git.
# Deployment context lives in the deployment documentation.

# ── Database (required) ────────────────────────────────────────────────
# PostgreSQL connection string for Postgres on this instance.
DATABASE_URL=

# ── AI services (required) ─────────────────────────────────────────────
# Provider used for generated card writing: anthropic or openai.
LLM_PROVIDER=anthropic
LLM_MODEL=
# Anthropic Claude — get a key at https://console.anthropic.com/ (starts sk-ant-)
ANTHROPIC_API_KEY=
# OpenAI — required only when LLM_PROVIDER=openai.
OPENAI_API_KEY=
# ── AstroApp (required for the astrology cards) ────────────────────────
# AstroApp needs ALL THREE: it logs in with email + password to mint a
# token, then sends the API key on every request. Sign up at
# https://astroapp.com/ (pay-per-use API; a personal instance is ~a few
# calls/day).
ASTROAPP_USERNAME=
ASTROAPP_PASSWORD=
ASTROAPP_API_KEY=

# ── File storage (required for uploads and stored media) ───────────────
# Keep this outside the GOE code folder. The same setting is used on a
# person's own computer or their own cloud server.
LOCAL_STORAGE_DIR=../goe-data/files

# ── App config ─────────────────────────────────────────────────────────
# IMPORTANT: the daily automatic astrology refresh (midnight sky fetch,
# overnight readings) ONLY runs when
# NODE_ENV=production — a deliberate gate so dev restarts never burn
# metered AstroApp calls. A self-hosted personal instance should run
# with NODE_ENV=production. See the deployment documentation.
NODE_ENV=development
# Personal production instances refresh by default. Set this to false only when the
# deployed instance must keep its existing astrology data without recurring paid calls.
ASTROAPP_REFRESH_ENABLED=true
PORT=5000

# Personal moon centres stay off until the owner has chosen and configured a practice.
# Enable both flags together, rebuild, then restart. No period-date fallback is used.
# See setup/moon-centres.md for the retained Kundalini implementation and setup.
MOON_CENTRES_ENABLED=false
VITE_MOON_CENTRES_ENABLED=false

# Default live HRV source offered by Movement and the homescreen.
# camera_ppg works in Safari/Chrome over HTTPS. bluetooth_rr requires a
# Web-Bluetooth browser and a device that supplies standard R-R intervals.
VITE_DEFAULT_HRV_SOURCE=camera_ppg

# GOE chat code ships intact but starts disabled. Enable both values only on
# a private owner instance whose agent connection has been configured.
CHAT_ENABLED=false
VITE_CHAT_ENABLED=false
# Required when chat is enabled: llm uses the Step 6 AI service;
# openclaw uses the owner's private OpenClaw gateway.
CHAT_DELIVERY=
# Required only when chat is enabled and routed through the owner's OpenClaw.
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=

# ── Your GOE instance (required) ───────────────────────────────────────
# Generate a permanent local owner ID with npm run setup:owner.
OWNER_ID=

# ── Optional CASTLE Lab connection ────────────────────────────────────
# These values come from the private Setup page at mygoe.app after per-card
# consent. Keep the credential private. Use only this owner's setup values.
BROKERAGE_API_URL=
CONTRIBUTION_CREDENTIAL=
CONTRIBUTION_CARDS=
# manual | biweekly. First contribution is explicit; biweekly begins after it succeeds.
CONTRIBUTION_SCHEDULE=biweekly

# Add the four values below only for each contribution area listed in CONTRIBUTION_CARDS.
# Valid contribution-area prefixes: CYCLICAL, REST_RESTORE, MOVEMENT,
# ASTROLOGY_ENERGETIC, RETURN_PATTERN.
# CONTRIBUTION_<CARD>_CONSENT_VERSION=
# CONTRIBUTION_<CARD>_INSTRUMENT_VERSION=
# CONTRIBUTION_<CARD>_MANIFEST_FINGERPRINT=
# CONTRIBUTION_<CARD>_MAPPING_VERSION=

# Optional local path for the random contribution ID and sequence counter.
# Default: ~/.goe/contribution-state.json
# CONTRIBUTION_STATE_PATH=

# ── Optional current-read feed to the owner's agent ───────────────────
# Set AGENT_FEED_REFRESH=off when this instance does not write an agent file.
AGENT_FEED_REFRESH=off
AGENT_FEED_REFRESH_SCRIPT=./setup/agent-feed/run-feed.sh
GOE_BASE_URL=http://127.0.0.1:5000
USER_MD_PATH=

# ── Hosting-specific variables ────────────────────────────────────────
# Leave provider-specific identity variables unset unless your deployment needs them.
